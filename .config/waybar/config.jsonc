{
    "layer": "top",
    "modules-center": ["hyprland/workspaces"],
    "modules-left": ["clock", "hyprland/window", "mpris", "custom/todo"],
    "modules-right": ["custom/pomodoro", "cpu", "memory", "network", "custom/brightness", "pulseaudio", "battery"],
    "battery": {
        "bat": "macsmc-battery",
        "adapter": "macsmc-ac",
        "format-full": "󱐋",
        "format-charging": "󱐋",
        "format": "{icon}",
        "format-icons": {
            "default": ["", "", "", "", ""]
        },
        "tooltip-format": " {capacity}% | {power}W | {timeTo} ",
        "interval": 10
    },
    "clock": {
        "interval": 2,
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "brave-browser --profile-directory=Default --app=https://calendar.notion.so/"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected":"󰖪",
        "tooltip-format": " {essid} ",
        "on-click": "ghostty --background-opacity=0.6 --class=waybar.float --command=impala"
    },
    "memory": {
        "interval": 10,
        "format": "  {percentage}%",
        "tooltip-format": " {used:0.1f}/{total:0.1f}G ",
        "on-click": "ghostty --background-opacity=0.8 --class=waybar.big.float --command='tmux attach -t utilities'"
    },
    "cpu": {
        "interval": 10,
        "format": "  {usage}%",
        "on-click": "ghostty --background-opacity=0.8 --class=waybar.big.float --command='tmux attach -t utilities'"
    },
    "hyprland/window": {
        "tooltip": false,
        "max-length": 40
    },
    "hyprland/workspaces": {
        "format": "{icon}{windows}",
        "format-window-separator": "",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<brave-browser>": "  ",
            "ghostty": "  ",
            "title<tmux.*>": "  "
	    }
    },
    "mpris": {
        "format": " ",
        "format-paused": " ",
        "format-stopped": " ",
        "interval": 1,
        "max-length": 30,
        "tooltip-format": "{title} - {artist}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 1,
        "on-click": "ghostty --background-opacity=0.6 --class=waybar.float --command=bluetui"
    },
    "custom/brightness": {
        "exec": "~/.config/waybar/scripts/brightness.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "brightnessctl set 5%+",
        "on-click-right": "brightnessctl set 5%-",
        "on-scroll-right": "brightnessctl set +2%",
        "on-scroll-left": "brightnessctl set 2%-"
    },
    "custom/todo": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/todo.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "ghostty --background-opacity=0.6 --class=waybar.float --command='nvim ~/.local/share/todo.md' &"
    }
}
