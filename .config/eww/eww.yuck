(defpoll time :interval "1s"
    "date '+%H:%M'"
)

(defwidget clock []
    (eventbox
        :class "clock"
        :orientation "horizontal"
        :halign "center"
        :cursor "pointer"
        (button
            :onclick "brave-browser --profile-directory=Default --app=https://web.morgen.so/"
            time
        )
    )
)

(defwidget layout []
    (box
        :class "layout"
        :orientation "vertical"
        :halign "center"
        (clock)
    )
)

(defwindow bar
    :class "bar"
    :monitor 0
    :geometry (geometry    
        :x "0%"
        :y "-32px"
        :anchor "top center"
    )
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore true
    (layout)
)
